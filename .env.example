# cod2-server-docker configuration
# Copy to .env and adjust. Full reference: docs/configuration.md

# --- Server binary ------------------------------------------------
# Binary = bin/cod2_lnxded_<COD2_VERSION>[_<COD2_VARIANT>]  (see bin/README.md)
COD2_VERSION=1_3
# e.g. nodelay_va_loc | nodelay | cracked | patch_va_loc | (empty = plain)
COD2_VARIANT=

# --- Basic server settings ----------------------------------------
NET_PORT=28960
MAXCLIENTS=32
#SV_HOSTNAME=My CoD2 Server
#FS_GAME=mymod
# Map library folder (fs_library), e.g. Library under ./game
#FS_LIBRARY=Library
# Config to +exec (relative to fs_game / main)
CONFIG=server.cfg
#MAP=mp_toujane
MAP_ROTATE=1

# --- libcod -------------------------------------------------------
# Which libcod2.so the server runs:
# auto  : ./libcod/libcod2.so if present, else fetched, else baked (default)
# off   : vanilla server, no libcod at all
# custom: ONLY ./libcod/libcod2.so (your local build; error if missing)
# fetch : ONLY the downloaded LIBCOD_URL / LIBCOD_ARTIFACT
# baked : ONLY the .so compiled into the image at image build time
LIBCOD_MODE=auto

# What gets COMPILED. Used by:
#  - the local builder:  docker compose --profile tools run --rm libcod-builder
#    (writes ./libcod/libcod2.so; used by custom/auto mode after a restart)
#  - the baked libcod:   docker compose build   (takes effect on image REBUILD only)
#LIBCOD_REPO=https://github.com/ibuddieat/zk_libcod
#LIBCOD_REF=dev
# doit.sh flags: mysql1 | mysql2 | nomysql, plus nospeex / debug / unsafe
#LIBCOD_BUILD_ARGS=mysql1 debug
#LIBCOD_URL=https://example.com/builds/libcod2.so
#LIBCOD_URL_FORCE=0
# ... or a zk_libcod CI artifact (built per commit; needs GITHUB_TOKEN; always nospeex):
#LIBCOD_ARTIFACT=libcod2_debian_mysql1
#LIBCOD_COMMIT=
#GITHUB_TOKEN=

# --- Extra cvars --------------------------------------------------
# Any COD2_SET_x / COD2_SETA_x / COD2_SETS_x becomes "+set x <value>" etc.
#COD2_SET_sv_punkbuster=0
#COD2_SET_rcon_password=change_me
#COD2_SETS_custom_serverinfo=hello

# --- Raw command line ---------------------------------------------
# Custom launch params, appended verbatim to the generated args:
#PARAMS=+set g_password secret +set sv_punkbuster 0
# Also available: PARAMS_BEFORE (inserted before generated args), PARAMS_AFTER (last)
# PARAMS_REPLACE=1 ignores everything generated and runs exactly PARAMS
#PARAMS_REPLACE=0

# --- Container behaviour ------------------------------------------
# File ownership for the server process (match your host user for WinSCP etc.)
PUID=1000
PGID=1000
# chown -R the game dir at start (off by default; bind mounts usually shouldn't)
CHOWN_GAME_DIR=0
# Mirror games_mp.log to `docker logs`
LOG_TO_STDOUT=0
#ENTRYPOINT_DRYRUN=0
